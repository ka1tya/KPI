@startuml
skinparam componentStyle uml2
skinparam shadowing false
top to bottom direction
skinparam nodesep 25
skinparam ranksep 40

actor "Студент" as Student
actor "Викладач" as Teacher
actor "Адміністратор" as Admin

rectangle "Course Platform (межа системи)" {

  package "Presentation" {
    component [Web UI\n(браузерний клієнт)] as UI
  }

  package "API" {
    interface "ICourseApi\nlistCourses, filterByCategory" as ICourseApi
    interface "IGroupApi\ncreateGroup, enrollStudents" as IGroupApi
    interface "IGradeApi\nsubmitMark, openEnrollment" as IGradeApi
    component [CourseController] as CC
    component [GroupController] as GrC
    component [GradeController] as GC
    interface "IAccessControl\nauthorize(user, action, group_id)" as IAccess
    interface "IRequestQueue\nenqueue" as IQueue
    component [AuthGuard] as AG
    component [RequestQueue] as RQ
  }

  package "Business" {
    interface "ICourseService\nfindCourses" as ICourseSvc
    interface "IGroupService\ncreateGroup, enrollStudents" as IGroupSvc
    interface "IGradeService\nupdateMark" as IGradeSvc
    component [CourseService] as CS
    component [GroupService] as GrS
    component [GradeService] as GS
    component [GroupScheduler] as GSch
    interface "INotification\nnotifyGroupStart(group_id, student_ids),\nnotifyGroupEnd(group_id, student_ids),\nnotifyCertificate(student_id, group_id)" as INotify
    component [NotificationService] as NS
  }

  package "Data Access" {
    interface "ICoursesRepo\nfindAll, findByCategory,\nfindTeacherIdByGroupId" as ICrsRepo
    interface "IGroupsRepo\nfindById, findStartingOn(date),\nfindEndingOn(date), create" as IGrpRepo
    interface "IEnrollmentsRepo\nfindByKey, findByGroupId,\nupdateGrade, create" as IEnrRepo
    interface "IStudentsRepo\nfindByIds" as IStdRepo
    component [CoursesRepository] as CR
    component [GroupsRepository] as GR
    component [EnrollmentsRepository] as ER
    component [StudentsRepository] as SR
  }

  interface "SQL" as ISql
  database "Relational DB\n(Courses, Students, Teachers,\nEnrollments, Categories, Groups)" as DB
}

interface "IIdentity\nvalidateToken, getProfile" as IIdent
interface "IEmail\nsendEmail" as IEmail
cloud "Identity Provider\n(зовнішня система)" as IdP
cloud "Email Service\n(зовнішня система)" as Email

' --- provided-інтерфейси ---
ICourseApi -- CC
IGroupApi -- GrC
IGradeApi -- GC
IAccess -- AG
IQueue -- RQ
ICourseSvc -- CS
IGroupSvc -- GrS
IGradeSvc -- GS
INotify -- NS
IEnrRepo -- ER
IGrpRepo -- GR
ICrsRepo -- CR
IStdRepo -- SR
ISql -- DB
IIdent -- IdP
IEmail -- Email

' --- required-інтерфейси (залежності) ---
Student --> UI
Teacher --> UI
Admin --> UI
UI ..> ICourseApi : HTTPS (UC-3, UC-4)
UI ..> IGroupApi : HTTPS (UC-1, UC-9)
UI ..> IGradeApi : HTTPS (UC-5, UC-6)
CC ..> ICourseSvc
GrC ..> IAccess
GrC ..> IGroupSvc
GC ..> IAccess : кожен запит
GC ..> IQueue : submitMark (UC-5)
GC ..> IEnrRepo : openEnrollment (UC-6)
RQ ..> IGradeSvc
CS ..> ICrsRepo
GrS ..> IGrpRepo
GrS ..> IEnrRepo
GrS ..> IStdRepo
GS ..> IEnrRepo
GS ..> IGrpRepo
GS ..> INotify : сертифікат (асинхронно, REQ-005)
GSch ..> IGrpRepo : групи за датою
GSch ..> IEnrRepo : студенти групи
GSch ..> INotify : початок і завершення групи
AG ..> IIdent
AG ..> ICrsRepo
NS ..> IIdent : email отримувача
NS ..> IEmail
ER ..> ISql
GR ..> ISql
CR ..> ISql
SR ..> ISql

note right of UI
  NFR-001: Chrome ≥130, Firefox ≥132, 360–3840 px
  NFR-005: тексти помилок українською за кодом
  Таймер 30 с (PT30S) на очікуванні відповіді (lab4)
end note

note right of RQ
  NFR-002: понад 30 одночасних запитів → черга,
  очікування до 30 с, далі відхилення
  з повідомленням про перевищення часу
end note

note left of GS
  isMarkInRange, isGroupEnded, calculateFinalScore,
  certificate_issued (REQ-004, 008, 012, 013, 014)
  notifyCertificate викликається після updateGrade
  асинхронно і не впливає на gradeResult (NFR-003),
  сповіщення протягом 10 хв (REQ-005)
end note

note right of GSch
  Не має provided-інтерфейсу: запускається
  за розкладом щодня на початку доби,
  а не іншим компонентом
  (REQ-015, REQ-016: сповіщення протягом 10 хв
  після настання start_date / end_date)
end note

note right of AG
  NFR-004: викладач змінює оцінки лише своїх курсів
  (Courses.teacher_id), адміністратор лише переглядає
end note

note right of NS
  Email отримувача береться з профілю IdP,
  бо в lab1 Students не має email
end note
@enduml
