@startuml
left to right direction
skinparam packageStyle rectangle

actor "Користувач платформи" as User
actor "Студент" as Student
actor "Викладач" as Teacher
actor "Адміністратор" as Admin

Student --|> User
Teacher --|> User
Admin --|> User

rectangle "Платформа курсів" {
  usecase "UC-1 Зарахувати студентів до групи" as UC1
  usecase "UC-3 Переглянути курси" as UC3
  usecase "UC-4 Фільтрувати за категорією" as UC4
  usecase "UC-5 Виставити або виправити бали" as UC5
  usecase "UC-6 Переглянути поточні результати студента" as UC6
  usecase "UC-9 Створити групу" as UC9
}

Admin --> UC1
User --> UC3
Teacher --> UC5
Teacher --> UC6
Admin --> UC6
Admin --> UC9

UC4 .> UC3 : <<extend>>
UC5 .> UC6 : <<include>>
@enduml
