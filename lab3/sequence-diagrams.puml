@startuml S5
 title S5 - Відхилення бала поза допустимим діапазоном

 actor "Викладач" as Teacher
 boundary "GradeController" as Controller
 control "GradeService" as GradeService
 database "Enrollments" as Enrollments
 
 ref over Teacher, Controller : Background: UC-6, перегляд поточних результатів (S7 / S8)

 Teacher -> Controller : submitMark(student_id, group_id, new_mark)
 note right : new_mark = -1 або 101 (Scenario Outline)
 activate Controller
 Controller -> GradeService : updateMark(student_id, group_id, new_mark)
 activate GradeService

 GradeService -> GradeService : isMarkInRange(new_mark)
 alt new_mark < 0 або new_mark > 100
   GradeService --> Controller : error(MARK_OUT_OF_RANGE)
   note right of GradeService : updateGrade не викликається:\nmark = 95 і final_score = 95% лишаються без змін
 else new_mark у межах 0..100
   ref over GradeService, Enrollments : перевірка групи, обчислення final_score і збереження (S1-S4)
   GradeService --> Controller : gradeResult(new_mark, final_score, certificate_issued)
 end
 deactivate GradeService
 Controller --> Teacher : відобразити помилку "MARK_OUT_OF_RANGE" або збережені значення
 deactivate Controller
@enduml

@startuml S6
 title S6 - Заборона редагування бала після завершення групи

 actor "Викладач" as Teacher
 boundary "GradeController" as Controller
 control "GradeService" as GradeService
 database "Enrollments" as Enrollments
 database "Groups" as Groups
 
 ref over Teacher, Controller : Background: UC-6, перегляд поточних результатів (S7 / S8)

 Teacher -> Controller : submitMark(student_id, group_id, 80)
 activate Controller
 Controller -> GradeService : updateMark(student_id, group_id, 80)
 activate GradeService

 GradeService -> GradeService : isMarkInRange(80) = true
 GradeService -> Groups : findById(group_id)
 activate Groups
 Groups --> GradeService : group(end_date)
 deactivate Groups
 GradeService -> GradeService : isGroupEnded(end_date) = true
 alt поточна дата пізніша за end_date (Groups.end_date)
   GradeService --> Controller : error("група завершена")
   note right of GradeService : updateGrade не викликається:\nmark = 70 і final_score = 70% лишаються без змін
 else група ще не завершена
   ref over GradeService, Enrollments : обчислення final_score і збереження (S1-S4)
   GradeService --> Controller : gradeResult(80, final_score, certificate_issued)
 end
 deactivate GradeService
 Controller --> Teacher : відобразити відхилення зміни або збережені значення
 deactivate Controller
@enduml

@startuml S7
 title S7 - Перегляд запису з виставленою оцінкою

 actor "Викладач" as Teacher
 boundary "GradeController" as Controller
 database "Enrollments" as Enrollments

 Teacher -> Controller : openEnrollment(student_id, group_id)
 activate Controller
 Controller -> Enrollments : findByKey(student_id, group_id)
 activate Enrollments
 Enrollments --> Controller : enrollment(mark=70, final_score=70%, certificate_issued=true)
 deactivate Enrollments
 opt mark != NULL 
   Controller --> Teacher : показати mark, final_score і certificate_issued
 end
 deactivate Controller
@enduml

@startuml S8
 title S8 - Перегляд запису без виставленої оцінки

 actor "Викладач" as Teacher
 boundary "GradeController" as Controller
 database "Enrollments" as Enrollments

 Teacher -> Controller : openEnrollment(student_id, group_id)
 activate Controller
 Controller -> Enrollments : findByKey(student_id, group_id)
 activate Enrollments
 Enrollments --> Controller : enrollment(mark=NULL)
 deactivate Enrollments
 opt mark = NULL
   Controller --> Teacher : показати повідомлення "Оцінку ще не виставлено"
 end
 deactivate Controller
@enduml
