@startuml S1
 title S1 - Успішне виставлення бала вище порогу сертифіката

 actor "Викладач" as Teacher
 boundary "GradeController" as Controller
 control "GradeService" as GradeService
 database "Enrollments" as Enrollments
 database "Groups" as Groups

 ref over Teacher, Controller : Background: UC-6, перегляд поточних результатів (S7 / S8)

 Teacher -> Controller : submitMark(student_id, group_id, 75)
 activate Controller
 Controller -> GradeService : updateMark(student_id, group_id, 75)
 activate GradeService

 GradeService -> GradeService : isMarkInRange(75) = true
 GradeService -> Groups : findById(group_id)
 activate Groups
 Groups --> GradeService : group(end_date)
 deactivate Groups
 GradeService -> GradeService : isGroupEnded(end_date) = false
 GradeService -> Enrollments : findByKey(student_id, group_id)
 activate Enrollments
 Enrollments --> GradeService : enrollment(mark = NULL, certificate_issued = false)
 deactivate Enrollments

 GradeService -> GradeService: final_score = calculateFinalScore(75%)
 alt final_score >= 60%
   GradeService -> GradeService : setCertificateIssued(true)
 else final_score < 60%
   GradeService -> GradeService : setCertificateIssued(false)
 end
 note right of GradeService : 75% >= 60%: гілка certificate_issued = true

 GradeService -> Enrollments : updateGrade(student_id, group_id, 75, final_score, certificate_issued)
 activate Enrollments
 Enrollments --> GradeService : saved
 deactivate Enrollments

 GradeService --> Controller : gradeResult(mark = 75, final_score, certificate_issued)
 deactivate GradeService
 Controller --> Teacher : відобразити збережені mark, final_score, certificate_issued
 deactivate Controller
@enduml

