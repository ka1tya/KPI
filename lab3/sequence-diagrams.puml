@startuml S5
 title S5 - Відхилення бала поза допустимим діапазоном
 actor "Викладач" as Teacher
 boundary "EnrollmentView" as View
 control "GradeController" as Controller
 control "GradeService" as GradeService
 database "EnrollmentRepository" as EnrollmentRepo
 database "GroupRepository" as GroupRepo
 participant "Clock" as Clock
 Teacher -> View ++: enterMark(studentId, groupId, newMark)
 View -> Controller ++: submitMark(studentId, groupId, newMark)
 Controller -> EnrollmentRepo ++: findByKey(studentId, groupId)
 EnrollmentRepo --> Controller --: enrollment(95, 95, true)
 Controller -> GroupRepo ++: findEndDate(groupId)
 GroupRepo --> Controller --: endDate
 Controller -> Clock ++: today()
 Clock --> Controller --: currentDate
 Controller -> GradeService ++: validateAndCalculate(newMark, currentDate, endDate)
 alt newMark < 0 or newMark > 100
   GradeService --> Controller: reject(MARK_OUT_OF_RANGE)
  Controller -> View: setOutcome(error, MARK_OUT_OF_RANGE, unchanged(95, 95, true))
 else newMark in range and group not ended
   GradeService -> GradeService: calculateFinalScore(newMark)\ncalculateCertificateStatus(newMark)
   GradeService --> Controller: gradeResult(newMark, finalScore, certificateIssued)
   Controller -> EnrollmentRepo: updateGrade(studentId, groupId, newMark, finalScore, certificateIssued)
   EnrollmentRepo --> Controller: saved
  Controller -> View: setOutcome(markSaved, newMark, finalScore, certificateIssued)
 else group ended
   GradeService --> Controller: reject(GROUP_ENDED)
  Controller -> View: setOutcome(error, GROUP_ENDED, unchanged(95, 95, true))
 end
 GradeService --> Controller --: processingComplete
 Controller --> View --: responseReady
 View --> Teacher --: displayOutcome
@enduml

@startuml S6
 title S6 - Заборона редагування бала після завершення групи
 actor "Викладач" as Teacher
 boundary "EnrollmentView" as View
 control "GradeController" as Controller
 control "GradeService" as GradeService
 database "EnrollmentRepository" as EnrollmentRepo
 database "GroupRepository" as GroupRepo
 participant "Clock" as Clock
 Teacher -> View ++: enterMark(studentId, groupId, 80)
 View -> Controller ++: submitMark(studentId, groupId, 80)
 Controller -> EnrollmentRepo ++: findByKey(studentId, groupId)
 EnrollmentRepo --> Controller --: enrollment(70, 70, certificateIssued)
 Controller -> GroupRepo ++: findEndDate(groupId)
 GroupRepo --> Controller --: endDate
 Controller -> Clock ++: today()
 Clock --> Controller --: currentDate
 Controller -> GradeService ++: validateAndCalculate(80, currentDate, endDate)
 alt currentDate > endDate
   GradeService --> Controller: reject(GROUP_ENDED)
  Controller -> View: setOutcome(error, GROUP_ENDED, unchanged(70, 70))
 else currentDate <= endDate and mark in range
   GradeService -> GradeService: calculateFinalScore(80)\ncalculateCertificateStatus(80)
   GradeService --> Controller: gradeResult(80, 80, certificateIssued)
   Controller -> EnrollmentRepo: updateGrade(studentId, groupId, 80, 80, certificateIssued)
   EnrollmentRepo --> Controller: saved
  Controller -> View: setOutcome(markSaved, 80, 80, certificateIssued)
 else mark out of range
   GradeService --> Controller: reject(MARK_OUT_OF_RANGE)
  Controller -> View: setOutcome(error, MARK_OUT_OF_RANGE, unchanged(70, 70))
 end
 GradeService --> Controller --: processingComplete
 Controller --> View --: responseReady
 View --> Teacher --: displayOutcome
@enduml

@startuml S7
 title S7 - Перегляд запису з виставленою оцінкою
 actor "Викладач" as Teacher
 boundary "EnrollmentView" as View
 control "EnrollmentController" as Controller
 database "EnrollmentRepository" as EnrollmentRepo
 Teacher -> View ++: openEnrollment(studentId, groupId)
 View -> Controller ++: getEnrollment(studentId, groupId)
 Controller -> EnrollmentRepo ++: findByKey(studentId, groupId)
 EnrollmentRepo --> Controller --: enrollment(mark=70, finalScore=70, certificateIssued=true)
 alt enrollment found and mark is set
  Controller -> View: setViewState(enrollmentDetails(70, 70, true))
 else enrollment found and mark is NULL
  Controller -> View: setViewState(enrollmentNotGraded)
 end
 Controller --> View --: responseReady
 View --> Teacher --: displayEnrollment
@enduml

@startuml S8
 title S8 - Перегляд запису без виставленої оцінки
 actor "Викладач" as Teacher
 boundary "EnrollmentView" as View
 control "EnrollmentController" as Controller
 database "EnrollmentRepository" as EnrollmentRepo
 Teacher -> View ++: openEnrollment(studentId, groupId)
 View -> Controller ++: getEnrollment(studentId, groupId)
 Controller -> EnrollmentRepo ++: findByKey(studentId, groupId)
 EnrollmentRepo --> Controller --: enrollment(mark=NULL)
 alt enrollment found and mark is NULL
  Controller -> View: setViewState(enrollmentNotGraded)
 else enrollment found and mark is set
  Controller -> View: setViewState(enrollmentDetails(mark, finalScore, certificateIssued))
 end
 Controller --> View --: responseReady
 View --> Teacher --: displayEnrollment
@enduml
