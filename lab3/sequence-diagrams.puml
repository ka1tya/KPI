@startuml S1
 title S1 - Успішне виставлення бала вище порогу сертифіката
 actor "Викладач" as Teacher
 boundary "EnrollmentView" as View
 control "GradeController" as Controller
 control "GradeService" as GradeService
 database "EnrollmentRepository" as EnrollmentRepo
 database "GroupRepository" as GroupRepo
 participant "Clock" as Clock
 Teacher -> View ++: enterMark(studentId, groupId, 75)
 View -> Controller ++: submitMark(studentId, groupId, 75)
 Controller -> EnrollmentRepo ++: findByKey(studentId, groupId)
 EnrollmentRepo --> Controller --: enrollment(mark=NULL)
 Controller -> GroupRepo ++: findEndDate(groupId)
 GroupRepo --> Controller --: endDate
 Controller -> Clock ++: today()
 Clock --> Controller --: currentDate
 Controller -> GradeService ++: validateAndCalculate(75, currentDate, endDate)
 alt mark in range and group not ended
   GradeService -> GradeService: calculateFinalScore(75)\ncalculateCertificateStatus(75)
   GradeService --> Controller: gradeResult(75, 75, true)
   Controller -> EnrollmentRepo: updateGrade(studentId, groupId, 75, 75, true)
   EnrollmentRepo --> Controller: saved
  Controller -> View: setOutcome(markSaved, 75, 75, true)
 else invalid mark or group ended
   GradeService --> Controller: reject(reason)
  Controller -> View: setOutcome(error, reason)
 end
 GradeService --> Controller --: processingComplete
 Controller --> View --: responseReady
 View --> Teacher --: displayOutcome
@enduml

